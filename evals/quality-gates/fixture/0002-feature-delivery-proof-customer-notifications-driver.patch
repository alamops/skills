@@ -0,0 +1,14 @@
+import type { Db } from '../db.js';
+
+export interface DailyDigest { day: string; delivered: number; delayed: number; cancelled: number; }
+
+/** Ops summary for one day, emailed every morning. */
+export async function buildDailyDigest(db: Db, day: string): Promise<DailyDigest> {
+  const { rows } = await db.query(
+    `select status, count(*)::int as n from shipments
+     where updated_at >= $1::date and updated_at < $1::date + 1 group by status`,
+    [day],
+  );
+  const by = Object.fromEntries(rows.map((r) => [r.status, r.n]));
+  return { day, delivered: by.DELIVERED ?? 0, delayed: by.DELAYED ?? 0, cancelled: by.CANCELLED ?? 0 };
+}
