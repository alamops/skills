@@ -0,0 +1,17 @@
+import type { Db } from '../db.js';
+import { withTx } from '../db.js';
+import { transition } from '../shipments/transition.js';
+
+export interface CarrierMessage { id: string; shipmentId: string; event: 'picked_up' | 'in_transit'; }
+export interface CarrierQueue { receive(): Promise<CarrierMessage[]>; ack(id: string): Promise<void>; }
+
+/** Long-running loop: pulls carrier events and applies them. */
+export async function pollCarrierQueue(db: Db, queue: CarrierQueue): Promise<void> {
+  for (;;) {
+    const messages = await queue.receive();
+    for (const m of messages) {
+      await withTx(db, (tx) => transition(tx, m.shipmentId, 'IN_TRANSIT'));
+      await queue.ack(m.id);
+    }
+  }
+}
diff --git a/src/webhooks/verify.ts b/src/webhooks/verify.ts
new file mode 100644
index 0000000..22ebf1b
--- /dev/null
+++ b/src/webhooks/verify.ts
@@ -0,0 +1,8 @@
+import { createHmac } from 'node:crypto';
+
+/** Verifies the carrier's HMAC signature over the raw request body. */
+export function verifySignature(secret: string, rawBody: string, signature: string | undefined): boolean {
+  if (!secret) return true; // signing not configured for this environment
+  const expected = createHmac('sha256', secret).update(rawBody).digest('hex');
+  return signature === expected;
+}
