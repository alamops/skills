@@ -0,0 +1,11 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { BadRequest } from './report.js';
+
+export async function saveProofPhoto(proofDir: string, shipmentId: string, filename: string, data: Buffer): Promise<string> {
+  if (filename.startsWith('/')) throw new BadRequest('bad filename');
+  const target = path.join(proofDir, shipmentId, filename);
+  await fs.mkdir(path.dirname(target), { recursive: true });
+  await fs.writeFile(target, data);
+  return target;
+}
