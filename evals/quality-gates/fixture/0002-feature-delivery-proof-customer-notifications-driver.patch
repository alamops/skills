+import pg from 'pg';
+
+/** Runs fn against the test database. */
+export async function withDb(fn: (db: pg.Pool) => Promise<void>): Promise<void> {
+  if (!process.env.DATABASE_URL) return;
+  const db = new pg.Pool({ connectionString: process.env.DATABASE_URL });
+  try {
+    await fn(db);
+  } finally {
+    await db.end();
+  }
+}
+
+export async function seedShipments(db: pg.Pool, n: number): Promise<string[]> {
+  const ids: string[] = [];
+  for (let i = 0; i < n; i++) {
+    const { rows } = await db.query(
+      "insert into shipments (status, route_id) values ('IN_TRANSIT', 'r1') returning id",
+    );
+    ids.push(rows[0].id);
+    await db.query("insert into assignments (shipment_id, driver_id, route_id, state) values ($1, 'driver-1', 'r1', 'accepted')", [rows[0].id]);
+  }
+  return ids;
+}
+
+export async function seedOutbox(db: pg.Pool, n: number): Promise<void> {
+  for (let i = 0; i < n; i++) {
+    await db.query(
+      "insert into outbox (kind, payload, state, attempts) values ('delayed', $1, 'pending', 0)",
+      [JSON.stringify({ customerEmail: `c${i}@example.com`, reason: 'weather' })],
+    );
+  }
+}
