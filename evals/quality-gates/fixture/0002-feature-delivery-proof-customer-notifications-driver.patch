+import type { Db } from '../db.js';
+import { withTx } from '../db.js';
+import { transition } from '../shipments/transition.js';
+import { completeShipment } from '../shipments/complete.js';
+import { driverMayUpdate } from './authorize.js';
+
+export interface DriverReport {
+  shipmentId: string;
+  status: 'in_transit' | 'delivered' | 'cancelled';
+  photoCount: number; // number of proof photos the app uploaded
+  note?: string;
+}
+
+export class Forbidden extends Error {}
+export class BadRequest extends Error {}
+
+export async function handleDriverReport(db: Db, driverId: string, report: DriverReport): Promise<void> {
+  if (!(await driverMayUpdate(db, driverId, report.shipmentId))) throw new Forbidden('not your shipment');
+  await withTx(db, async (tx) => {
+    if (report.status === 'cancelled') {
+      await transition(tx, report.shipmentId, 'CANCELLED');
+      return;
+    }
+    if (report.status === 'in_transit') {
+      await transition(tx, report.shipmentId, 'IN_TRANSIT');
+      return;
+    }
+    if (report.photoCount < 1) throw new BadRequest('proof photo required');
+    await completeShipment(tx, report.shipmentId);
+  });
+}
