@@ -0,0 +1,20 @@
+import type { NotificationKind } from './outbox.js';
+
+export interface Email { to: string; subject: string; html: string; }
+
+export function render(kind: NotificationKind, payload: Record<string, unknown>): Email {
+  switch (kind) {
+    case 'delivered':
+      return {
+        to: String(payload.customerEmail),
+        subject: 'Your parcel was delivered',
+        html: `<p>Delivered at ${payload.deliveredAt}.</p><img src="${payload.photoUrl}" alt="proof of delivery">`,
+      };
+    case 'delayed':
+      return {
+        to: String(payload.customerEmail),
+        subject: 'Your parcel is delayed',
+        html: `<p>Reason: ${payload.reason}</p>`,
+      };
+  }
+}
