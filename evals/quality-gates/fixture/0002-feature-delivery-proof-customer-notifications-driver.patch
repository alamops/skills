+import type { Db } from '../db.js';
+import { withTx } from '../db.js';
+import type { Config } from '../config.js';
+import type { Mailer } from './mailer.js';
+import { render } from './render.js';
+
+async function currentEmailMode(db: Db, cfg: Config): Promise<'dry-run' | 'live'> {
+  const { rows } = await db.query("select value from settings where key = 'email_mode' order by updated_at desc limit 1");
+  return (rows[0]?.value as 'dry-run' | 'live' | undefined) ?? cfg.emailMode;
+}
+
+/** Sends pending outbox rows. Called on a timer. */
+export async function dispatchBatch(db: Db, cfg: Config, mailer: Mailer): Promise<void> {
+  const mode = await currentEmailMode(db, cfg);
+  await withTx(db, async (tx) => {
+    const { rows } = await tx.query(
+      "select * from outbox where state = 'pending' order by id limit 50 for update",
+    );
+    for (const row of rows) {
+      try {
+        const email = render(row.kind, row.payload);
+        if (mode === 'live') await mailer.send(email);
+        await tx.query("update outbox set state = 'sent', sent_at = now() where id = $1", [row.id]);
+      } catch {
+        await tx.query('update outbox set attempts = attempts + 1 where id = $1', [row.id]);
+      }
+    }
+  });
+}
