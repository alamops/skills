@@ -0,0 +1,12 @@
+import type { Db } from '../db.js';
+
+/** A driver may update a shipment only if they hold its assignment. */
+export async function driverMayUpdate(db: Db, driverId: string, shipmentId: string): Promise<boolean> {
+  const { rows: [shipment] } = await db.query('select route_id from shipments where id = $1', [shipmentId]);
+  if (!shipment) return false;
+  const { rows } = await db.query(
+    'select driver_id from assignments where route_id = $1 limit 1',
+    [shipment.route_id],
+  );
+  return rows[0]?.driver_id === driverId;
+}
