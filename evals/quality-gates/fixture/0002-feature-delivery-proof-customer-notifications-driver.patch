+import { request } from 'undici';
+import type { Email } from './render.js';
+
+export interface Mailer { send(email: Email): Promise<void>; }
+
+export function httpMailer(apiUrl: string): Mailer {
+  return {
+    async send(email) {
+      const res = await request(apiUrl, { method: 'POST', body: JSON.stringify(email), headers: { 'content-type': 'application/json' } });
+      if (res.statusCode >= 300) throw new Error(`mail api ${res.statusCode}`);
+    },
+  };
+}
