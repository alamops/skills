+import type { Db } from '../db.js';
+
+export async function assignDriver(db: Db, shipmentId: string, driverId: string): Promise<void> {
+  await db.query(
+    `insert into assignments (shipment_id, driver_id, route_id, state, expires_at)
+     select $1, $2, route_id, 'offered', now() + interval '120 seconds' from shipments where id = $1`,
+    [shipmentId, driverId],
+  );
+}
+
+export async function reassign(db: Db, shipmentId: string): Promise<void> {
+  const { rows } = await db.query(
+    "select id from drivers where busy_with is null and active order by last_seen_at desc limit 1",
+  );
+  if (rows[0]) await assignDriver(db, shipmentId, rows[0].id);
+}
