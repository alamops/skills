+import { describe, it, expect } from 'vitest';
+import { withDb, seedOutbox } from './helpers/db.js';
+import { dispatchBatch } from '../src/notifications/dispatch.js';
+import type { Config } from '../src/config.js';
+
+const cfgLive = { emailMode: 'live' } as Config;
+
+describe('dispatchBatch', () => {
+  it('sends each notification once after a transient failure', async () => withDb(async (db) => {
+    await db.query("delete from settings where key = 'email_mode'");
+    await seedOutbox(db, 3);
+    const sent: string[] = [];
+    let calls = 0;
+    const mailer = {
+      async send(email: { to: string }) {
+        calls++;
+        if (calls === 1) throw new Error('boom');
+        sent.push(email.to);
+      },
+    };
+    await dispatchBatch(db, cfgLive, mailer as never);
+    await dispatchBatch(db, cfgLive, mailer as never);
+    expect(sent.length).toBeGreaterThanOrEqual(3);
+  }));
+
+  it('renders the delayed email', async () => {
+    const { render } = await import('../src/notifications/render.js');
+    expect(render('delayed', { customerEmail: 'a@b.c', reason: 'snow' }).subject).toContain('delayed');
+  });
+});
