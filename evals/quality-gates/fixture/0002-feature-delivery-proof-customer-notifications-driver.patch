+import type { Tx } from '../db.js';
+
+export type NotificationKind = 'delivered' | 'delayed';
+
+export async function enqueue(tx: Tx, kind: NotificationKind, payload: Record<string, unknown>): Promise<void> {
+  await tx.query(
+    "insert into outbox (kind, payload, state, attempts) values ($1, $2, 'pending', 0)",
+    [kind, JSON.stringify(payload)],
+  );
+}
