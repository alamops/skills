+import type { CarrierQueue } from './queue.js';
+
+export async function connectCarrierQueue(): Promise<CarrierQueue> {
+  const url = process.env.CARRIER_QUEUE_URL ?? 'http://localhost:9324/queue/carrier';
+  return {
+    async receive() {
+      const res = await fetch(`${url}/receive`);
+      return (await res.json()) as Awaited<ReturnType<CarrierQueue['receive']>>;
+    },
+    async ack(id) {
+      await fetch(`${url}/ack/${id}`, { method: 'POST' });
+    },
+  };
+}
