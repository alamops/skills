@@ -0,0 +1,29 @@
+import type { WebSocket } from 'ws';
+import type { EventEmitter } from 'node:events';
+import type { Db } from '../db.js';
+import { reassign } from './assign.js';
+
+const sockets = new Map<string, WebSocket>();
+
+export function registerSocket(driverId: string, ws: WebSocket): void {
+  sockets.set(driverId, ws);
+  ws.on('close', () => sockets.delete(driverId));
+}
+
+export interface DriverMessage { driverId: string; shipmentId: string; payload: unknown; }
+
+export async function onDriverMessage(db: Db, msg: DriverMessage): Promise<void> {
+  const ws = sockets.get(msg.driverId);
+  if (!ws) {
+    // driver unreachable: hand the shipment to someone else
+    await db.query("update assignments set state = 'undelivered' where shipment_id = $1", [msg.shipmentId]);
+    await reassign(db, msg.shipmentId);
+    return;
+  }
+  ws.send(JSON.stringify(msg.payload));
+}
+
+/** Every API instance subscribes to the shared driver-message channel. */
+export function subscribeDriverMessages(bus: EventEmitter, db: Db): void {
+  bus.on('driver-message', (m: DriverMessage) => { void onDriverMessage(db, m); });
+}
