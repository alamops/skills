+import type { Tx } from '../db.js';
+import { transition } from './transition.js';
+
+export async function completeShipment(tx: Tx, shipmentId: string): Promise<void> {
+  await transition(tx, shipmentId, 'DELIVERED');
+  // release the driver and drop the temporary photo copies
+  await tx.query('update drivers set busy_with = null where busy_with = $1', [shipmentId]);
+  await tx.query('delete from temp_photos where shipment_id = $1', [shipmentId]);
+}
