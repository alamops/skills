+import { describe, it, expect } from 'vitest';
+
+describe('transition table', () => {
+  it('does not allow leaving DELIVERED', async () => {
+    const { transition } = await import('../src/shipments/transition.js');
+    const tx = { query: async (sql: string) => (sql.startsWith('select') ? { rows: [{ status: 'DELIVERED' }] } : { rows: [] }) };
+    await expect(transition(tx as never, 's1', 'CANCELLED')).rejects.toThrow('illegal transition');
+  });
+});
