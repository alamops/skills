@@ -0,0 +1,25 @@
+import type { FastifyInstance } from 'fastify';
+import type { Db } from '../db.js';
+
+export const ADMIN_ACTIONS = ['refund', 'reassign'] as const;
+
+export function registerAdminRoutes(app: FastifyInstance, db: Db) {
+  app.addHook('preHandler', async (req, reply) => {
+    const action = (req.params as { action?: string }).action;
+    if (action && (ADMIN_ACTIONS as readonly string[]).includes(action) && !req.user?.isAdmin) {
+      return reply.code(403).send({ error: 'admin only' });
+    }
+  });
+
+  app.post('/admin/:action(refund)/:id', async (req) => {
+    const { id } = req.params as { id: string };
+    await db.query('insert into refunds (shipment_id) values ($1)', [id]);
+    return { ok: true };
+  });
+
+  app.post('/admin/:action(reassign)/:id', async (req) => {
+    const { id } = req.params as { id: string };
+    await db.query("update assignments set state = 'released' where shipment_id = $1", [id]);
+    return { ok: true };
+  });
+}
