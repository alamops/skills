new file mode 100644
index 0000000..d00b289
--- /dev/null
+++ b/src/shipments/transition.ts
@@ -0,0 +1,19 @@
+import type { Tx } from '../db.js';
+
+export type Status = 'CREATED' | 'ASSIGNED' | 'IN_TRANSIT' | 'DELIVERED' | 'CANCELLED';
+
+const LEGAL: Record<Status, Status[]> = {
+  CREATED: ['ASSIGNED', 'CANCELLED'],
+  ASSIGNED: ['IN_TRANSIT', 'CANCELLED'],
+  IN_TRANSIT: ['DELIVERED', 'CANCELLED'],
+  DELIVERED: [],
+  CANCELLED: [],
+};
+
+export async function transition(tx: Tx, shipmentId: string, to: Status): Promise<void> {
+  const { rows } = await tx.query('select status from shipments where id = $1 for update', [shipmentId]);
+  if (rows.length === 0) throw new Error(`shipment ${shipmentId} not found`);
+  const from = rows[0].status as Status;
+  if (!LEGAL[from].includes(to)) throw new Error(`illegal transition ${from} -> ${to}`);
+  await tx.query('update shipments set status = $2, updated_at = now() where id = $1', [shipmentId, to]);
+}
